<Window x:Class="WpfApp1.Admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Admin" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Gemini_Generated_Image_z9ubvnz9ubvnz9ub.png"/>
        </Grid.Background>
        <DataGrid x:Name="tabelaAdmin" HorizontalAlignment="Center" Height="150" Margin="0,177,0,0" VerticalAlignment="Top" Width="492" d:ItemsSource="{d:SampleData ItemCount=5}" IsReadOnly="True" SelectionChanged="tabelaAdmin_SelectionChanged" />

        <Label Content="BEM VINDO A TELA DE ADMIN!!" HorizontalAlignment="Left" Height="44" Margin="206,67,0,0" VerticalAlignment="Top" Width="440" HorizontalContentAlignment="Center" FontSize="30" Background="#FF7CD4F9" FontFamily="Sitka Heading"/>
        <Button Content="Update" HorizontalAlignment="Left" Height="38" Margin="684,289,0,0" VerticalAlignment="Top" Width="106" Background="#FF4EFF00" Click="Button_Click_1"/>
        <Button x:Name="Delete" Content="Delete" HorizontalAlignment="Left" Height="38" Margin="684,177,0,0" VerticalAlignment="Top" Width="106" Click="Button_Click" Background="#FFFF9999"/>

    </Grid>
</Window>
